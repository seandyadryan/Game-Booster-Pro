#!/bin/sh
set -e

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/increment_build_number.ps1
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/increment_build_number.ps1
else
  echo "PowerShell tidak ditemukan, build number gagal dinaikkan." >&2
  exit 1
fi

git add pubspec.yaml
